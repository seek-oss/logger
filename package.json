{
  "name": "@seek/logger",
  "version": "12.1.0",
  "private": false,
  "description": "Standardized logging",
  "homepage": "https://github.com/seek-oss/logger#readme",
  "bugs": {
    "url": "https://github.com/seek-oss/logger/issues"
  },
  "license": "MIT",
  "author": {
    "name": "SEEK"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seek-oss/logger.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "skuba build-package",
    "clean": "rm -fr lib",
    "format": "skuba format",
    "lint": "skuba lint",
    "release": "pnpm build && changeset publish",
    "stage": "changeset version && pnpm skuba-changelog-inject && pnpm format",
    "test": "skuba test",
    "test:ci": "skuba test --coverage",
    "test:watch": "skuba test --watch"
  },
  "dependencies": {
    "@pinojs/redact": "^0.4.0",
    "dtrim": "^1.13.3",
    "pino": "^10.1.0",
    "pino-std-serializers": "^7.0.0"
  },
  "devDependencies": {
    "@types/split2": "4.2.3",
    "skuba": "16.4.1",
    "split2": "4.2.0",
    "sury": "11.0.0-alpha.4"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "packageManager": "pnpm@11.28.2",
  "inlinedDependencies": {
    "sury": "11.0.0-alpha.4"
  },
  "skuba": {
    "entryPoint": "src/index.ts",
    "template": null,
    "type": "package",
    "version": "16.4.0"
  }
}
